<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Caveman.Compliance</RootNamespace>
    <PackageId>Caveman.Compliance</PackageId>
    <Version>1.0.0</Version>
    <Authors>Francesco Paolo Passaro</Authors>
    <Company>DigitalSolutions</Company>
    <Title>Caveman.Compliance</Title>
    <Description>AI compliance engine for LLM gateways: one rule registry (risk, action, scope) over PII, secrets, prompt-injection, agent-policy, toxicity, PHI, data-residency and code-vulnerability controls; a traceability matrix to EU AI Act / GDPR / NIS 2 / ISO 42001 articles; a hash-chained audit trail (Art. 12); and technical file, DPIA, FRIA and executive report generated as JSON and as PDF through Stilo.</Description>
    <PackageTags>compliance;ai-act;gdpr;nis2;llm;governance;audit;dpia;fria;pdf;privacy;guardrails</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>caveman-icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/francescopaolopassaro/Caveman.Compliance</PackageProjectUrl>
    <RepositoryUrl>https://github.com/francescopaolopassaro/Caveman.Compliance</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) 2026 Passaro Francesco Paolo</Copyright>
    <PackageReleaseNotes>1.0.0: first release. Port of Synthelion 1.2.5's AI Compliance Engine to .NET, with PDF generation through Stilo.Documents.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Caveman.PrivacyGuard" Version="1.3.1" />
    <PackageReference Include="Stilo.Documents" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="caveman-icon.png" LogicalName="Caveman.Compliance.caveman-icon.png" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="CHANGELOG.md" Pack="true" PackagePath="\" />
    <None Include="caveman-icon.png" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Caveman.Compliance.Tests" />
  </ItemGroup>

</Project>
